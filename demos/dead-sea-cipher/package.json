{
  "name": "dead-sea-cipher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive demo walking 2,600 years of cryptographic history \u2014 from Atbash (~600 BCE) to AES-256-GCM (2001 CE).",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "license": "MIT",
  "homepage": "https://systemslibrarian.github.io/crypto-lab-dead-sea-cipher/",
  "repository": {
    "type": "git",
    "url": "https://github.com/systemslibrarian/crypto-lab-dead-sea-cipher.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "test:claims": "playwright test e2e/claims.spec.ts",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "gh-pages": "^6.3.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
